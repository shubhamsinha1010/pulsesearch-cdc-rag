# Copy to .env and adjust as needed. All values have safe local defaults.

# --- MySQL (system of record) ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=pulsesearch
MYSQL_USER=pulse
MYSQL_PASSWORD=pulse

# --- Ingest firehose ---
# source: wikimedia | github
INGEST_SOURCE=wikimedia
# Comma-separated wikis to keep (empty = all). Keep it small for a light demo.
INGEST_WIKIS=enwiki

# --- Kafka / CDC ---
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_SOURCE_TOPIC=pulse.pulsesearch.pages
KAFKA_GROUP_ID=pulsesearch-sync

# --- Elasticsearch ---
ES_URL=http://elasticsearch:9200
ES_INDEX=pages

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- Async Wikipedia summary enrichment (post-index; keeps sync latency low) ---
SUMMARY_ENRICHMENT=true
SUMMARY_ENRICHMENT_WORKERS=2
SUMMARY_FETCH_CONCURRENCY=8

# --- LLM (Groq, hosted free tier) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
